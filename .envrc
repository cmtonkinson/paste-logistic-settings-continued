# Puts the Lua 5.2 toolchain from `make deps` first on PATH, so `lua`,
# `luarocks`, `busted`, `luacheck`, and `factestio` resolve the pinned version.

watch_file .hererocks/bin/lua

if [ -d .hererocks/bin ]; then
  PATH_add .hererocks/bin
else
  log_error "no .hererocks/ toolchain yet -- run 'make deps'"
fi
